<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(DEVELOPMENT_TEAM).com.altmansoftwaredesign.belvedere</string>
	</array>
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<!-- Required for WKWebView inside a sandboxed app extension. Without it the
	     WebContent process never completes its load, didFinish never fires, and
	     the preview renders blank. Verified on this fork: removing it produced
	     exactly that, while the extension still launched and qlmanage still
	     exited cleanly — so a blank preview is the only symptom. Remote content
	     is blocked by the Content-Security-Policy in the Quick Look shell
	     instead of by the sandbox. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Quick Look grants the extension the previewed file, but not sibling
	     images. The read-only exception lets InlineLocalAssets embed relative
	     images as cid: QLPreviewReplyAttachment entries. -->
	<key>com.apple.security.temporary-exception.files.absolute-path.read-only</key>
	<array>
		<string>/</string>
	</array>
</dict>
</plist>
